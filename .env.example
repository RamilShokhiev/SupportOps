# Synthetic local demo. Copy to .env; no provider keys are required.
MODE=demo
DATABASE_URL=postgresql+psycopg://supportops:supportops-local@127.0.0.1:5432/supportops
POSTGRES_PASSWORD=supportops-local
LLM_PROVIDER=demo
EMBEDDING_PROVIDER=demo
ISSUE_PROVIDER=demo
DEMO_PASSWORD=demo-supportops
SEED_DEMO=true
COOKIE_SECURE=false
RETAILBRIDGE_URL=http://127.0.0.1:8001
API_TIMEOUT_SECONDS=2
LLM_TIMEOUT_SECONDS=30
MAX_OUTPUT_TOKENS=1200
EMBEDDING_DIMENSIONS=256
DEMO_ISSUE_MODE=normal
# JSON arrays/objects, not comma-separated strings.
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]
# Optional real providers. Enable deliberately; these may incur usage costs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# Set current provider pricing before interpreting live cost estimates.
# INPUT_COST_PER_MILLION=
# OUTPUT_COST_PER_MILLION=
# EMBEDDING_COST_PER_MILLION=
GITHUB_TOKEN=
GITHUB_REPOSITORIES={}
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
